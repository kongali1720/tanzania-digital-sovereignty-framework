NODE_ENV=production
HOST=0.0.0.0
PORT=8443
SERVICE_ID=kongali1720-bilateral-gateway
JURISDICTION=TZ-SOVEREIGN-BRIDGE
# Ganti dengan secret kuat / hasil injeksi KMS/HSM saat produksi (minimal 32 karakter)
KONGALI1720_SIGNING_KEY=change-this-to-a-strong-random-secret-key-min-32-chars
# Pisahkan beberapa API key partner/institusi dengan koma
ALLOWED_API_KEYS=tz-dpi-partner-key-change-me,id-bridge-partner-key-change-me
MAX_IDEMPOTENCY_ENTRIES=10000
